{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { 
      "source": "/", 
      "destination": "/frontend/HTML/index.html" 
    },
    { 
      "source": "/login", 
      "destination": "/frontend/HTML/login.html" 
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/JavaScript/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/CSS/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "/frontend/Imagens/$1"
    }
  ]
}