# =============================================================
# AUTOACERTO — VARIÁVEIS DE AMBIENTE (BACKEND)
# =============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório!
#
# Para gerar um JWT_SECRET seguro, use no terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================

# -------------------------------------------------------
# BANCO DE DADOS
# -------------------------------------------------------
# String de conexão do PostgreSQL (Railway, Supabase, etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# -------------------------------------------------------
# SERVIDOR
# -------------------------------------------------------
# Porta em que o servidor vai escutar (Railway define automaticamente)
PORT=3000

# Ambiente de execução: "development" ou "production"
NODE_ENV=development

# -------------------------------------------------------
# AUTENTICAÇÃO JWT
# -------------------------------------------------------
# Segredo para assinar os tokens JWT.
# OBRIGATÓRIO — o servidor não inicia sem este valor.
# Use uma string longa e aleatória (mínimo 64 caracteres).
JWT_SECRET=cole_aqui_um_segredo_longo_e_aleatorio

# -------------------------------------------------------
# CORS — Origens permitidas
# -------------------------------------------------------
# Lista de origens permitidas, separadas por vírgula.
# Em desenvolvimento, inclua localhost com a porta do seu servidor de arquivos.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# -------------------------------------------------------
# DONO DO SISTEMA (Super Admin)
# -------------------------------------------------------
# Usuário master criado automaticamente na primeira inicialização.
# Troque a senha imediatamente após o primeiro login!
DONO_SISTEMA_NOME=Administrador Master
DONO_SISTEMA_EMAIL=admin@suaempresa.com.br
DONO_SISTEMA_SENHA=troque_esta_senha_imediatamente
